; REEL'S TOOLS — projet Godot 4 (testé avec Godot 4.7)

config_version=5

[application]

config/name="REEL'S TOOLS"
config/description="Outils studio pour compositeurs, ingés son et beatmakers."
config/version="0.1.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.0118, 0.0118, 0.0118, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Tex="*res://core/tex.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/resizable=true
window/dpi/allow_hidpi=true
window/stretch/mode="disabled"

[gui]

theme/custom_font="res://assets/fonts/ArchivoNarrow-Variable.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=8192
environment/defaults/default_clear_color=Color(0.039, 0.0235, 0.0157, 1)
textures/default_filters/anisotropic_filtering_level=3
